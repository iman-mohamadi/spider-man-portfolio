    "sprint":     { "src": "Sprint.fbx",                                "hips": "full",       "rootXZ": "detrend", "armRest": "align", "armSpread": 12 },
    "jump":       { "src": "Jumping.fbx",                               "hips": "crouchOnly", "rootXZ": "strip" },
    "runJump":    { "src": "Running Jump.fbx",                          "hips": "crouchOnly", "rootXZ": "strip", "armRest": "align", "armSpread": 4 },
