    "idleLookB":  { "src": "Action Adventure Pack/idle.fbx",            "hips": "full",       "rootXZ": "strip", "armRest": "align" },
    "walk":       { "src": "Walking.fbx",                               "hips": "full",       "rootXZ": "detrend", "armRest": "align", "armSpread": 5 },
